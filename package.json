{
  "name": "obsidian-polyglot-helper",
  "version": "1.10.0",
  "description": "Look up English and Japanese words in your notes and get a study card with meaning, reading, examples and audio, kept in a word list you review.",
  "main": "src/main.ts",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "build-with-check": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test *.test.mjs",
    "lint": "eslint --max-warnings 0 . && eslint --max-warnings 0 -c eslint.scorecard.config.mjs . && stylelint --max-warnings 0 styles.css"
  },
  "keywords": [
    "obsidian-md",
    "obsidian-plugin",
    "language-learning",
    "japanese",
    "english",
    "translation"
  ],
  "author": "Rexxall",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rexxall/obsidian-polyglot-helper.git"
  },
  "bugs": {
    "url": "https://github.com/Rexxall/obsidian-polyglot-helper/issues"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^16.11.6",
    "builtins": "^5.0.1",
    "esbuild": "0.17.3",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.13.0",
    "obsidian": "1.13.0",
    "stylelint": "^16.26.1",
    "tslib": "2.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "openai": "^5.9.0"
  }
}
